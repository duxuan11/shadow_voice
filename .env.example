# ============================================================
# Shadow Voice 环境变量模板（复制为 .env 后填入真实值）
#   cp .env.example .env
# ============================================================

# ── 数据目录 ───────────────────────────────────────────
# 视频 / 字幕 / 缩略图 / JSON 索引（consolidated.json、meta.json）所在目录。
# 默认项目根下的 data。可填相对项目根的路径或绝对路径。
# dev（vite）、npm run server、npm run build 三处共用此变量。
DATA_DIR=./data

# ── 服务器 ─────────────────────────────────────────────
# 后端 API 端口（默认 3001）
PORT=3001

# JWT 签名密钥（生产环境务必改成随机长字符串）
JWT_SECRET=shadow-voice-dev-secret-change-in-production

# ── 阿里云口语评测（智能科教内容生成平台）──────────────
# 从阿里云控制台「口语评测」项目获取（AppKey / AppId）
SSECP_APP_ID=

# 应用密钥（仅后端使用，严禁出现在前端代码中）
SSECP_APP_SECRET=

# 授权接口地址（一般无需修改；多地域容灾可切换 gate-01/02/03）
SSECP_AUTH_URL=https://api.cloud.ssapi.cn/auth/authorize

# 授权 ID 有效期（秒，默认 7200；前端可在此窗口内复用）
SSECP_WARRANT_TTL=7200

# ── AI 对话（OpenAI 兼容接口，默认 DeepSeek）────────────────
# 必填：无 key 时 AI 对话不可用（明确提示，不伪造结果）
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat

# ── 语音合成 TTS（AI 对话中朗读 AI 台词）──────────────────
# 可选 edge（默认，微软 Edge 在线合成，免 key，需能访问外网）或 aliyun（需下面三件套）
TTS_PROVIDER=edge
# Edge 发音人（默认 en-US-AriaNeural；可选 en-US-JennyNeural / en-US-GuyNeural 等）
EDGE_TTS_VOICE=en-US-AriaNeural

# 阿里云智能语音交互 —— 开通后填三件套：
#   - TTS_PROVIDER 改为 aliyun 启用 AI 台词朗读
#   - 同时自动启用语音输入（一句话识别，替代被墙的浏览器 Web Speech）
ALIYUN_NLS_APP_KEY=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 区域（默认 cn-shanghai）与英语发音人（控制台确认，如 Catherine/Henry）
ALIYUN_NLS_REGION=cn-shanghai
ALIYUN_NLS_VOICE=aixia
